{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!dist", "!coverage", "!.temp", "!public", "!**/*.md"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" }
  },
  "overrides": [
    {
      "includes": ["src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "转换管线必须与界面无关：domain 层不允许引入 React",
                  "react-dom": "转换管线必须与界面无关：domain 层不允许引入 React DOM",
                  "zustand": "转换管线必须与界面无关：domain 层不允许引入状态库"
                }
              }
            },
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "document": "转换管线必须与界面无关：domain 层不允许访问 DOM",
                  "window": "转换管线必须与界面无关：domain 层不允许访问 DOM",
                  "HTMLElement": "转换管线必须与界面无关：domain 层不允许访问 DOM",
                  "CanvasRenderingContext2D": "转换管线必须与界面无关：domain 层不允许访问画布上下文"
                }
              }
            }
          }
        }
      }
    }
  ]
}
